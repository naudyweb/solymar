# SolyMar Paracas - Configuración Optimizada .htaccess

RewriteEngine On

# 1. FORZAR HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. REDIRIGIR dominio antiguo (.site), www y cualquier alias → solymarparacas.com (dominio canónico)
# (excluye el subdominio interno de reservas, que vive dentro de public_html/reservas
# y por eso hereda este .htaccess aunque tiene su propio host)
RewriteCond %{HTTP_HOST} !^solymarparacas\.com$ [NC]
RewriteCond %{HTTP_HOST} !^reservas\.solymarparacas\.com$ [NC]
RewriteRule ^(.*)$ https://solymarparacas.com/$1 [R=301,L]

# 2b. Como reservas/ vive dentro de public_html, tambien es alcanzable en
# solymarparacas.com/reservas/ — se bloquea esa ruta cuando se accede por el
# dominio principal; solo debe responder en reservas.solymarparacas.com.
RewriteCond %{HTTP_HOST} ^solymarparacas\.com$ [NC]
RewriteCond %{REQUEST_URI} ^/reservas(/|$)
RewriteRule ^ - [F,L]

# 3. REDIRIGIR .html → URL limpia (evitar contenido duplicado)
RewriteCond %{THE_REQUEST} \.html[\s?/]
RewriteRule ^(.+?)\.html$ /$1 [R=301,L]

# Redirecciones de Tours Estandarizados (301)
RewriteRule ^atv-gokart(\.html)?$ /mini-buggies-paracas [R=301,L,NC]
RewriteRule ^en/atv-gokart(\.html)?$ /en/mini-buggies-paracas [R=301,L,NC]

# 4. EVITAR LISTADO DE DIRECTORIOS
Options -Indexes

# 5. COMPRESIÓN GZIP (Acelera la carga)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml
</IfModule>

# 6. CACHÉ DEL NAVEGADOR (Mejora velocidad en visitas recurrentes)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# 7. HSTS (forzar HTTPS en navegador por 1 año)
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# 8. REMOVER EXTENSIÓN .HTML DE LAS URLS (SEO Friendly)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# 9. SEGURIDAD: Bloquear acceso a archivos sensibles
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
